{% if request.page_type == 'product' %}
{% assign cfg = app.metafields.product_timer.settings.value %}
{% assign heading = cfg.heading | default: 'FLASH DEAL ENDS IN' %}
{% assign note = cfg.urgencyNote | default: 'Order before the timer runs out to claim your special price.' %}
{% assign bg_color = cfg.bgColor | default: '#fff5f5' %}
{% assign border_color = cfg.borderColor | default: '#feb2b2' %}
{% assign text_color = cfg.textColor | default: '#1a202c' %}
{% assign digit_bg = cfg.digitBgColor | default: '#e53e3e' %}
{% assign digit_text = cfg.digitTextColor | default: '#ffffff' %}
{% assign init_hours = cfg.hours | default: '04' | plus: 0 %}
{% assign init_mins = cfg.minutes | default: '30' | plus: 0 %}

<div
  id="pp-countdown-wrapper"
  class="pp-countdown-card"
  data-hours="{{ init_hours }}"
  data-mins="{{ init_mins }}"
  style="
    background: {{ bg_color }};
    border: 1.5px solid {{ border_color }};
    color: {{ text_color }};
    padding: 16px 20px;
    border-radius: 12px;
    margin: 0 0 18px 0;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.05);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    display: none;
  "
>
  <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
    <div style="flex: 1; min-width: 180px;">
      <div style="display: flex; align-items: center; gap: 6px; margin-bottom: 4px;">
        <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: {{ digit_bg }}; animation: pp-pulse 1.5s infinite;"></span>
        <span style="font-weight: 800; font-size: 13px; letter-spacing: 0.6px; text-transform: uppercase;">{{ heading }}</span>
      </div>
      {% if note != blank %}
        <div style="font-size: 12.5px; opacity: 0.85; line-height: 1.4;">{{ note }}</div>
      {% endif %}
    </div>

    <div style="display: flex; align-items: center; gap: 6px;">
      <div style="background: {{ digit_bg }}; color: {{ digit_text }}; padding: 8px 10px; border-radius: 8px; min-width: 46px; text-align: center; box-shadow: 0 2px 6px rgba(0,0,0,0.12);">
        <div class="pp-cd-hrs" style="font-size: 18px; font-weight: 800; line-height: 1.1; font-variant-numeric: tabular-nums;">{{ init_hours }}</div>
        <div style="font-size: 9px; font-weight: 600; opacity: 0.85; margin-top: 2px; letter-spacing: 0.5px;">HRS</div>
      </div>
      <span style="font-weight: 800; font-size: 16px; opacity: 0.6;">:</span>
      <div style="background: {{ digit_bg }}; color: {{ digit_text }}; padding: 8px 10px; border-radius: 8px; min-width: 46px; text-align: center; box-shadow: 0 2px 6px rgba(0,0,0,0.12);">
        <div class="pp-cd-mins" style="font-size: 18px; font-weight: 800; line-height: 1.1; font-variant-numeric: tabular-nums;">{{ init_mins }}</div>
        <div style="font-size: 9px; font-weight: 600; opacity: 0.85; margin-top: 2px; letter-spacing: 0.5px;">MIN</div>
      </div>
      <span style="font-weight: 800; font-size: 16px; opacity: 0.6;">:</span>
      <div style="background: {{ digit_bg }}; color: {{ digit_text }}; padding: 8px 10px; border-radius: 8px; min-width: 46px; text-align: center; box-shadow: 0 2px 6px rgba(0,0,0,0.12);">
        <div class="pp-cd-secs" style="font-size: 18px; font-weight: 800; line-height: 1.1; font-variant-numeric: tabular-nums;">59</div>
        <div style="font-size: 9px; font-weight: 600; opacity: 0.85; margin-top: 2px; letter-spacing: 0.5px;">SEC</div>
      </div>
    </div>
  </div>
</div>

<style>
@keyframes pp-pulse {
  0% { transform: scale(0.95); opacity: 1; }
  50% { transform: scale(1.3); opacity: 0.5; }
  100% { transform: scale(0.95); opacity: 1; }
}
</style>

<script>
(function() {
  function mountAboveProductTitle() {
    var card = document.getElementById('pp-countdown-wrapper');
    if (!card || card.dataset.mounted) return;

    // 自动匹配主流 Shopify 主题（Dawn, Debut, Prestige, Impulse 等）的产品标题容器
    var titleSelectors = [
      '.product__title',
      '.product-single__title',
      '.product-meta__title',
      'h1.title',
      '.product__info-container h1',
      'main h1'
    ];

    var targetEl = null;
    for (var i = 0; i < titleSelectors.length; i++) {
      var el = document.querySelector(titleSelectors[i]);
      if (el) {
        targetEl = el;
        break;
      }
    }

    if (targetEl && targetEl.parentNode) {
      targetEl.parentNode.insertBefore(card, targetEl);
    }
    card.style.display = 'block';
    card.dataset.mounted = 'true';

    // 启动毫秒级精准倒数
    var h = parseInt(card.dataset.hours || '4', 10);
    var m = parseInt(card.dataset.mins || '30', 10);
    var totalSeconds = (h * 3600) + (m * 60);
    var hrsEl = card.querySelector('.pp-cd-hrs');
    var minsEl = card.querySelector('.pp-cd-mins');
    var secsEl = card.querySelector('.pp-cd-secs');

    function tick() {
      if (totalSeconds <= 0) totalSeconds = (h * 3600) + (m * 60);
      var ch = Math.floor(totalSeconds / 3600);
      var cm = Math.floor((totalSeconds % 3600) / 60);
      var cs = totalSeconds % 60;
      if (hrsEl) hrsEl.textContent = String(ch).padStart(2, '0');
      if (minsEl) minsEl.textContent = String(cm).padStart(2, '0');
      if (secsEl) secsEl.textContent = String(cs).padStart(2, '0');
      totalSeconds--;
    }
    tick();
    setInterval(tick, 1000);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', mountAboveProductTitle);
  } else {
    mountAboveProductTitle();
  }
})();
</script>
{% endif %}

{% schema %}
{
  "name": "Product Deal Countdown",
  "target": "body",
  "settings": []
}
{% endschema %}